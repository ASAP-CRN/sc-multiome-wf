#!/usr/bin/env python3

import argparse
import os
from os import listdir
from os.path import isfile, join


def modality(filename, sample_id):
    # FASTQs have already been renamed to {sample_id}_{modality}_S[0-9]+_...
    name = filename.removeprefix(sample_id).lower()
    if "atac" in name:
        return "ATAC"
    if "rna" in name:
        return "RNA"
    return None


LIBRARY_TYPES = {
    "ATAC": "Chromatin Accessibility",
    "RNA": "Gene Expression",
}


def main(args):
    fastqs_dir_path = os.path.join(os.getcwd(), "fastqs")

    rows = []
    for entry in sorted(os.listdir(fastqs_dir_path)):
        library = modality(entry, args.sample_id)
        if library is None:
            raise ValueError(f"Could not determine library type for {entry}")
        # The sample column must match the FASTQ name prefix preceding _S[0-9]+
        row = f"{fastqs_dir_path},{args.sample_id}_{library},{LIBRARY_TYPES[library]}"
        if row not in rows:
            rows.append(row)

    csv_content = "\n".join(["fastqs,sample,library_type"] + rows)
    with open(args.output, "w") as file:
        file.write(csv_content)

    print(f"Finished generating {args.output}:")
    print(csv_content)


if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        description="Generate the Cell Ranger Libraries CSV which declares the input FASTQ data for the libraries that make up a Feature Barcode experiment"
    )
    parser.add_argument(
        "-s",
        "--sample-id",
        type=str,
        required=True,
        help="Sample ID"
    )
    parser.add_argument(
        "-o",
        "--output",
        type=str,
        required=True,
        help="Output file name for the Libraries CSV"
    )

    args = parser.parse_args()

    main(args)
