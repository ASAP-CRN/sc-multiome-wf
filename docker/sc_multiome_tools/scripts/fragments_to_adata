#!/usr/bin/env python3

import argparse
from typing import Optional
import snapatac2 as snap


def add_metadata(
    adata: snap.AnnData,
    team_id: str,
    dataset_id: str,
    sample_id: str,
    batch: str,
    sex: str,
    brain_region_level_1: str,
    brain_region_level_2: str,
    brain_region_level_3: str,
    pool_id: Optional[str] = None,
    source_subject_id: Optional[str] = None,
    subject_id: Optional[str] = None,
):
    print("Adding metadata to AnnData object")
    adata.obs["sample"] = sample_id
    adata.obs["batch"] = batch
    adata.obs["sex"] = sex
    adata.obs["brain_region_level_1"] = brain_region_level_1
    adata.obs["brain_region_level_2"] = brain_region_level_2
    adata.obs["brain_region_level_3"] = brain_region_level_3
    adata.obs["team"] = team_id
    adata.obs["dataset"] = dataset_id
    adata.obs["batch_id"] = f"{team_id}_{dataset_id}_{batch}"

    if pool_id is not None:
        adata.obs["pool"] = pool_id
        adata.obs["source_subject"] = source_subject_id
        adata.obs["subject"] = subject_id

    return adata


def main(args):
    # This computes basic QC metrics like the number of unique fragments per cell, fraction of duplicated reads and fraction of mitochondrial read 
    adata = snap.pp.import_fragments(
        fragment_file=args.cellranger_arc_fragments,
        chrom_sizes=snap.genome.hg38,
        sorted_by_barcode=False
    )
    adata = add_metadata(
        adata,
        team_id=args.team_id,
        dataset_id=args.dataset_id,
        sample_id=args.sample_id,
        batch=args.batch,
        sex=args.sex,
        brain_region_level_1=args.brain_region_level_1,
        brain_region_level_2=args.brain_region_level_2,
        brain_region_level_3=args.brain_region_level_3,
        pool_id=args.pool_id,
        source_subject_id=args.source_subject_id,
        subject_id=args.subject_id,
    )

    # Compute scores and add vars to in-memory AnnData
    snap.metrics.tsse(adata, snap.genome.hg38)
    snap.pp.add_tile_matrix(adata, bin_size=500)

    adata.write(
        filename=args.adata_output
    )
    print(f"Wrote {args.adata_output}")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        description="Convert Cell Ranger ARC ATAC fragments to AnnData objects"
    )
    parser.add_argument(
        "-f",
        "--cellranger-arc-fragments",
        type=str,
        required=True,
        help="The Cell Ranger ARC atac_fragments.tsv.gz output that is the barcoded and aligned fragment file"
    )
    parser.add_argument(
        "-t",
        "--team-id",
        type=str,
        required=True,
        help="CRN Team ID"
    )
    parser.add_argument(
        "-d",
        "--dataset-id",
        type=str,
        required=True,
        help="ASAP dataset ID"
    )
    parser.add_argument(
        "-s",
        "--sample-id",
        type=str,
        required=True,
        help="ASAP sample ID"
    )
    parser.add_argument(
        "-b",
        "--batch",
        type=str,
        required=True,
        help="ASAP batch from which the sample/dataset originated"
    )
    parser.add_argument(
        "-x",
        "--sex",
        type=str,
        required=True,
        help="The sample's sex"
    )
    parser.add_argument(
        "--brain-region-level-1",
        type=str,
        required=False,
        help="Abbreviation of most granular anatomical region (Level 1)"
    )
    parser.add_argument(
        "--brain-region-level-2",
        type=str,
        required=False,
        help="Abbreviation of intermediate level anatomical region (Level 2)"
    )
    parser.add_argument(
        "--brain-region-level-3",
        type=str,
        required=False,
        help="Abbreviation of coarse level anatomical region (Level 3)"
    )
    parser.add_argument(
        "-p",
        "--pool-id",
        type=str,
        required=False,
        default=None,
        help="Source pool ID used to construct 'batch_id'; provided only for multiplexed samples"
    )
    parser.add_argument(
        "-a",
        "--source-subject-id",
        type=str,
        required=False,
        default=None,
        help="Source subject/donor ID; provided only for multiplexed samples"
    )
    parser.add_argument(
        "-j",
        "--subject-id",
        type=str,
        required=False,
        default=None,
        help="ASAP subject/donor ID; provided only for multiplexed samples"
    )
    parser.add_argument(
        "-o",
        "--adata-output",
        type=str,
        required=True,
        help="Output file name for saving the AnnData object"
    )

    args = parser.parse_args()

    main(args)
