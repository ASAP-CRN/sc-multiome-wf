#!/usr/bin/env python3

import argparse
import pandas as pd
from cellbender.remove_background.downstream import anndata_from_h5


def main(args):
    metadata = pd.read_csv(
        args.metadata,
        sep="\t",
        dtype=str,
        header=None,
        names=["source_subject_id", "sample_id"],
    )
    subject_to_sample = dict(zip(metadata["source_subject_id"], metadata["sample_id"]))

    adata = anndata_from_h5(
        filename=args.cellbender_counts
    )
    adata.var_names_make_unique()

    barcodes = pd.read_csv(args.cell_barcodes, sep="\t", dtype=str)
    # A barcode is only unique within a pool, so keep this pool's rows only
    barcodes = barcodes[barcodes["sample"] == args.pool_id]
    if barcodes.empty:
        raise ValueError(
            f"No rows with sample == '{args.pool_id}' in {args.cell_barcodes}"
        )

    # Vireo suffixes barcodes with the pool ID; CellBender uses '-1'
    barcodes["cell_barcode"] = barcodes["cell_barcode"].str.replace(
        f"-{args.pool_id}", "-1", regex=False
    )

    adata.obs["pool"] = args.pool_id
    adata.obs["source_subject"] = adata.obs_names.map(
        dict(zip(barcodes["cell_barcode"], barcodes["cell_type"]))
    )

    # Unmatched barcodes are NaN, which drops doublets/unassigned along with them
    matched = int(adata.obs["source_subject"].notna().sum())
    print(f"Matched {matched}/{adata.n_obs} cells in pool {args.pool_id}")
    adata = adata[adata.obs["source_subject"].notna()].copy()
    print(adata.obs["source_subject"].value_counts().to_string())

    subjects = set(adata.obs["source_subject"].unique())
    unmapped = subjects - set(subject_to_sample)
    if unmapped:
        raise ValueError(
            f"Subjects in {args.cell_barcodes} with no sample_id in "
            f"{args.metadata}: {sorted(unmapped)}"
        )
    no_cells = set(subject_to_sample) - subjects
    if no_cells:
        print(f"[WARN] Subjects with no cells in pool {args.pool_id}: {sorted(no_cells)}")

    adata.obs["dataset"] = args.dataset_id
    adata.obs["sample"] = adata.obs["source_subject"].map(subject_to_sample)

    for subject in sorted(subjects):
        subset = adata[adata.obs["source_subject"] == subject].copy()
        sample_id = subject_to_sample[subject]
        output_filenames = [
            f"{subject}.demux_counts.h5ad",
            f"{args.dataset_id}.{sample_id}.{args.pool_id}.demux_counts.h5ad"
        ]
        for file in output_filenames:
            subset.write_h5ad(
                filename=file
            )
            print(f"Wrote {file} ({subset.n_obs} cells)")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        description="Demultiplex Cellbender counts (.h5) and export as AnnData objects"
    )
    parser.add_argument(
        "-i",
        "--cellbender-counts",
        type=str,
        required=True,
        help="The CellBender remove-background h5 output for a single pool"
    )
    parser.add_argument(
        "-c",
        "--cell-barcodes",
        type=str,
        required=True,
        help="The cell barcodes generated from Vireo assignment file with columns: sample (pool), cell_type (subject), and cell_barcode"
    )
    parser.add_argument(
        "-m",
        "--metadata",
        type=str,
        required=True,
        help="Headerless TSV mapping source_subject_id to ASAP sample_id, one pair per line"
    )
    parser.add_argument(
        "-p",
        "--pool-id",
        type=str,
        required=True,
        help="Source pool ID; provided only for multiplexed samples"
    )
    parser.add_argument(
        "-d",
        "--dataset-id",
        type=str,
        required=True,
        help="ASAP dataset ID"
    )

    args = parser.parse_args()

    main(args)
