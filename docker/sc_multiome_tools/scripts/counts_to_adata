#!/usr/bin/env python3

import argparse
import scanpy as sc


def prep_metadata(
    adata: sc.AnnData,
    team_id: str,
    dataset_id: str,
    sample_id: str,
    batch: str,
    sex: str,
    pool_id: Optional[str] = None,
    source_subject_id: Optional[str] = None,
    subject_id: Optional[str] = None,
):
    # Set CPUs to use for parallel computing
    sc.settings.n_jobs = -1

    adata.var_names_make_unique()
    adata.var["mt"] = adata.var_names.str.contains(r"^MT-", case=False, regex=True)
    adata.var["rb"] = adata.var_names.str.contains(r"^(RPL|RPS|MRPL|MRPS)", case=False, regex=True)
    sc.pp.calculate_qc_metrics(
        adata,
        qc_vars=["rb", "mt"],
        percent_top=None,
        log1p=False,
        inplace=True,
    )

    sc.pp.scrublet(adata)
    # Keep the metadata clean and drop predicted_doublet; rely on the probability of doublet (i.e., doublet_score)
    adata.obs.drop("predicted_doublet", axis=1, inplace=True)

    print("Adding metadata to AnnData object")
    adata.obs["sample"] = sample_id
    adata.obs["batch"] = batch
    adata.obs["sex"] = sex
    adata.obs["team"] = team_id
    adata.obs["dataset"] = dataset_id
    adata.obs["batch_id"] = f"{team_id}_{dataset_id}_{batch}"

    if pool_id is not None:
        adata.obs["pool"] = pool_id
        adata.obs["source_subject"] = source_subject_id
        adata.obs["subject"] = subject_id

    return adata


def main(args):
    adata = sc.read_h5ad(
        filename=args.cellbender_counts_adata
    )
    adata = prep_metadata(
        adata,
        team_id=args.team_id,
        dataset_id=args.dataset_id,
        sample_id=args.sample_id,
        batch=args.batch,
        sex=args.sex,
        pool_id=args.pool_id,
        source_subject_id=args.source_subject_id,
        subject_id=args.subject_id,
    )

    adata.write_h5ad(
        filename=args.adata_output
    )
    print(f"Wrote {args.adata_output}")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        description="Convert Cell Ranger ARC RNA counts to AnnData objects"
    )
    parser.add_argument(
        "-c",
        "--cellbender-counts-adata",
        type=str,
        required=True,
        help="The demultiplexed Cellbender counts (.h5ad)"
    )
    parser.add_argument(
        "-t",
        "--team-id",
        type=str,
        required=True,
        help="CRN Team ID"
    )
    parser.add_argument(
        "-d",
        "--dataset-id",
        type=str,
        required=True,
        help="ASAP dataset ID"
    )
    parser.add_argument(
        "-s",
        "--sample-id",
        type=str,
        required=True,
        help="ASAP sample ID"
    )
    parser.add_argument(
        "-b",
        "--batch",
        type=str,
        required=True,
        help="ASAP batch from which the sample/dataset originated"
    )
    parser.add_argument(
        "-x",
        "--sex",
        type=str,
        required=True,
        help="The sample's sex"
    )
    parser.add_argument(
        "-p",
        "--pool-id",
        type=str,
        required=False,
        default=None,
        help="Source pool ID used to construct 'batch_id'; provided only for multiplexed samples"
    )
    parser.add_argument(
        "-a",
        "--source-subject-id",
        type=str,
        required=False,
        default=None,
        help="Source subject/donor ID; provided only for multiplexed samples"
    )
    parser.add_argument(
        "-j",
        "--subject-id",
        type=str,
        required=False,
        default=None,
        help="ASAP subject/donor ID; provided only for multiplexed samples"
    )
    parser.add_argument(
        "-o",
        "--adata-output",
        type=str,
        required=True,
        help="Output file name for saving the AnnData object"
    )

    args = parser.parse_args()

    main(args)
