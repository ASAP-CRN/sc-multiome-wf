#!/usr/bin/env python3

import argparse
import numpy as np
import anndata
import pandas as pd
import scipy.sparse as sp
import mudata as md
import scanpy as sc
from scipy.stats import pearsonr
import hdf5plugin


def benjamini_hochberg(pvals):
    """
    Benjamini-Hochberg q-values for a 1-D array of p-values.

    Each cell type runs 10^5-10^6 correlations, so a nominal p cut admits a number
    of links close to the chance expectation. Implemented directly to avoid adding
    a statsmodels dependency.
    """
    p = np.asarray(pvals, dtype=float)
    n = p.size
    if n == 0:
        return p
    order = np.argsort(p)
    ranked = p[order] * n / np.arange(1, n + 1)
    ranked = np.minimum.accumulate(ranked[::-1])[::-1]
    q = np.empty(n, dtype=float)
    q[order] = np.clip(ranked, 0.0, 1.0)
    return q


def parse_peak_coords(var: pd.DataFrame):
    if {"chrom", "start", "end"}.issubset(var.columns):
        coords = var[["chrom", "start", "end"]].copy()
    else:
        s = var.index.to_series().str.replace("-", ":", n=1, regex=False).str.split(":", expand=True)
        coords = pd.DataFrame(
            {"chrom": s[0].values, "start": s[1].astype(int).values, "end": s[2].astype(int).values},
            index=var.index,
        )
    coords["mid"] = (coords["start"] + coords["end"]) // 2
    return coords


def load_gene_tss(tss_bed: str):
    """
    Read the Cell Ranger ARC TSS BED: chrom, start, end, gene_id, score, strand.

    Passing fewer `names` than the file has columns makes pandas fold the leading
    columns into the index instead of failing -- which silently yields strand
    values as gene names -- so the column count is checked rather than assumed.
    A bare 3-column chrom/tss/gene table is also accepted.
    """
    bed = pd.read_csv(tss_bed, sep="\t", header=None)
    if bed.shape[1] >= 4:
        tss = pd.DataFrame({
            "chrom": bed[0].astype(str),
            "tss": bed[1].astype(int),
            "gene_name": bed[3].astype(str),
        })
    elif bed.shape[1] == 3:
        tss = pd.DataFrame({
            "chrom": bed[0].astype(str),
            "tss": bed[1].astype(int),
            "gene_name": bed[2].astype(str),
        })
    else:
        raise ValueError(
            f"{tss_bed} has {bed.shape[1]} columns; expected a BED with at least "
            "chrom, start, end (gene id in column 4) or chrom, tss, gene."
        )
    print(f"Loaded {len(tss)} TSS records for {tss['gene_name'].nunique()} genes "
          f"on {tss['chrom'].nunique()} contigs; e.g. {tss['gene_name'].iloc[0]}")
    return tss


def correlate_group(
    rna, atac, peak_coords, tss, window, min_cells, corr_threshold, pval_threshold,
    fdr_threshold, group_label
):
    """Correlate expression vs accessibility of nearby peaks within a single cell group."""
    # The ARC TSS bed keys on Ensembl ids, while var_names are symbols, so match on
    # var['gene_id'] when it exists and fall back to var_names otherwise.
    if "gene_id" in rna.var:
        rna_genes = pd.Index(rna.var["gene_id"].astype(str))
    else:
        rna_genes = pd.Index(rna.var_names)
    X_rna = rna.X.tocsc() if sp.issparse(rna.X) else np.asarray(rna.X)
    X_atac = atac.X.tocsc() if sp.issparse(atac.X) else np.asarray(atac.X)

    records = []
    n_tss_in = len(tss)
    matched = tss[tss["gene_name"].isin(rna_genes)]
    if matched.empty:
        raise ValueError(
            "No TSS gene id matches the RNA object. "
            f"TSS ids e.g. {tss['gene_name'].head(3).tolist()}; "
            f"RNA ids e.g. {rna_genes[:3].tolist()} "
            f"(from var['gene_id'])" if "gene_id" in rna.var else
            f"(from var_names; var has no 'gene_id', columns: {list(rna.var.columns)})"
        )
    tss = matched
    n_near = n_tested = n_sparse = n_nan = 0
    n_const_gene = n_const_peak = 0

    for _, g in tss.iterrows():
        gene = g["gene_name"]
        near = peak_coords[
            (peak_coords["chrom"] == g["chrom"])
            & ((peak_coords["mid"] - g["tss"]).abs() <= window)
        ]
        if near.empty:
            continue
        n_near += len(near)

        gi = rna_genes.get_loc(gene)
        gi = gi if isinstance(gi, int) else int(np.flatnonzero(gi)[0])
        expr = X_rna[:, gi]
        expr = np.asarray(expr.todense()).ravel() if sp.issparse(expr) else np.asarray(expr).ravel()
        # pearsonr is undefined for a constant vector; a gene flat across the group
        # can never link, so skip it before iterating its nearby peaks.
        if np.ptp(expr) == 0:
            n_const_gene += 1
            continue

        for peak_name in near.index:
            pi = atac.var_names.get_loc(peak_name)
            acc = X_atac[:, pi]
            acc = np.asarray(acc.todense()).ravel() if sp.issparse(acc) else np.asarray(acc).ravel()
            if (acc > 0).sum() < min_cells:
                n_sparse += 1
                continue
            if np.ptp(acc) == 0:
                n_const_peak += 1
                continue
            n_tested += 1
            r, p = pearsonr(expr, acc)
            if np.isnan(r):
                n_nan += 1
                continue
            distance = int(near.loc[peak_name, "mid"] - g["tss"])
            records.append((group_label, gene, peak_name, r, p, distance))

    links = pd.DataFrame(
        records, columns=["cell_type", "gene", "peak", "pearson_r", "pval", "distance_to_tss"]
    )
    n_raw = len(links)
    if not links.empty:
        # BH across every test in this cell type, before any filtering
        links["qval"] = benjamini_hochberg(links["pval"].to_numpy())
        links = links[
            (links["pearson_r"].abs() >= corr_threshold)
            & (links["pval"] <= pval_threshold)
            & (links["qval"] <= fdr_threshold)
        ]
    else:
        links["qval"] = pd.Series(dtype=float)
    print(f"[{group_label}] genes matched {len(tss)}/{n_tss_in} TSS | "
          f"peaks in window {n_near} | flat genes {n_const_gene} | "
          f"dropped <{min_cells} cells {n_sparse} | flat peaks {n_const_peak} | "
          f"correlated {n_tested} | nan r {n_nan} | before thresholds {n_raw} | "
          f"expected by chance {n_raw * pval_threshold:.0f} | retained {len(links)}")
    return links


def link_by_celltype(
    mdata, tss, celltype_key, window, min_cells, corr_threshold, pval_threshold,
    fdr_threshold, min_group_cells
):
    rna_all = mdata.mod["rna"][mdata.obs_names]
    # Prefer the called cell-type peak matrix (mod['peaks']) over raw tiles
    # (mod['atac']); linkage should correlate against actual called peaks.
    atac_key = "peaks" if "peaks" in mdata.mod else "atac"
    print(f"Using accessibility from mod['{atac_key}']")
    atac_all = mdata.mod[atac_key][mdata.obs_names]
    peak_coords = parse_peak_coords(atac_all.var)

    labels = mdata.obs[celltype_key]
    all_links = []
    for ct in labels.dropna().unique():
        mask = (labels == ct).values
        if mask.sum() < min_group_cells:
            print(f"[{ct}] skipped ({mask.sum()} cells < {min_group_cells})")
            continue
        rna_ct = rna_all[mask]
        atac_ct = atac_all[mask]
        all_links.append(
            correlate_group(
                rna_ct, atac_ct, peak_coords, tss, window, min_cells, corr_threshold, pval_threshold,
                fdr_threshold, ct
            )
        )

    if all_links:
        result = pd.concat(all_links, ignore_index=True)
        result = result.sort_values(["cell_type", "pearson_r"], ascending=[True, False]).reset_index(drop=True)
    else:
        result = pd.DataFrame(
            columns=["cell_type", "gene", "peak", "pearson_r", "pval", "qval", "distance_to_tss"]
        )
    print(f"Total cell-type-resolved links: {len(result)}")
    return result


def main(args):
    anndata.settings.allow_write_nullable_strings = False

    mdata = md.read_h5mu(args.mudata_input)
    peaks = sc.read_h5ad(args.celltype_peaks_adata_input)
    tss = load_gene_tss(args.tss_bed)

    shared = mdata.obs_names.intersection(peaks.obs_names)
    mdata.mod["peaks"] = peaks[shared].copy()
    mdata.update()
    
    links = link_by_celltype(
        mdata, tss, args.celltype_key, args.window, args.min_cells,
        args.corr_threshold, args.pval_threshold, args.fdr_threshold,
        args.min_group_cells
    )

    links.to_csv(args.links_output, index=False)
    print(f"Wrote {args.links_output}")

    mdata.uns["peak_gene_links_by_celltype"] = links
    mdata.write(
        filename=args.mudata_output,
        compression="gzip"
    )
    print(f"Wrote {args.mudata_output}")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        description="Cell-type-resolved peak-to-gene linkage (per-population correlation)"
    )
    parser.add_argument(
        "-a",
        "--mudata-input",
        type=str,
        required=True,
        help="MuData (.h5mu) object with paired 'rna' and 'atac' and transferred cell_type labels",
    )
    parser.add_argument(
        "-b",
        "--celltype-peaks-adata-input",
        type=str,
        required=True,
        help="Cell-type peaks matrix AnnData from peak_calling; folded in as the accessibility source so linkage correlates against called peaks rather than raw tiles",
    )
    parser.add_argument(
        "-t",
        "--tss-bed",
        type=str,
        required=True,
        help="Tab-separated gene TSS table: chrom, tss, gene_name (no header) obtained from Cell Ranger ARC",
    )
    parser.add_argument(
        "-k",
        "--celltype-key",
        type=str,
        required=True,
        help="Column in mdata.obs holding transferred cell type labels [cell_type]",
    )
    parser.add_argument(
        "-w",
        "--window",
        type=int,
        required=True,
        help="Distance in bp up/downstream of the TSS to search for peaks [500000]",
    )
    parser.add_argument(
        "-c",
        "--min-cells",
        type=int,
        required=True,
        help="Min cells in which a peak must be accessible to be tested [10]",
    )
    parser.add_argument(
        "-m",
        "--min-group-cells",
        type=int,
        required=True,
        help="Minimum cells in a cell type to run linkage for that group [50]",
    )
    parser.add_argument(
        "-r",
        "--corr-threshold",
        type=float,
        required=True,
        help="Minimum absolute Pearson correlation to retain a link [0.1]",
    )
    parser.add_argument(
        "-p",
        "--pval-threshold",
        type=float,
        required=True,
        help="Maximum p-value to retain a link [0.05]",
    )
    parser.add_argument(
        "-q",
        "--fdr-threshold",
        type=float,
        default=0.05,
        help="Benjamini-Hochberg FDR across all tests within a cell type; the nominal p cut alone admits roughly chance-level links at this test count [0.05]",
    )
    parser.add_argument(
        "-o",
        "--mudata-output",
        type=str,
        required=True,
        help="Output file name for saving the MuData object",
    )
    parser.add_argument(
        "-l",
        "--links-output", 
        type=str,
        required=True,
        help="Output CSV file name for the cell-type-resolved links table",
    )

    args = parser.parse_args()

    main(args)
